# Copy to .env. All values are optional.

# Region used for the session and, unless --regions is passed, the region scanned.
AWS_REGION=us-east-1

# Optional cross-account audit role. When set, CloudShield assumes it via STS
# with refreshable credentials.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/SecurityAuditRole
# AWS_EXTERNAL_ID=optional-external-id
# AWS_ROLE_SESSION_NAME=CloudShieldSession

# Default output paths (also settable with --report / --results).
CLOUDSHIELD_REPORT_PATH=cloudshield_report.pdf
CLOUDSHIELD_RESULTS_PATH=cloudshield_results.json
